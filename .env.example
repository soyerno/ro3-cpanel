# RO3 CPanel Environment Configuration

SERVER_TITLE=RO3 Control Panel
SERVER_SUBTITLE=Ragnarok Online 3 Server Management
LOGO_TEXT=RO3

HOST=0.0.0.0
PORT=8095

# Path to ro3emu.db (SQLite database)
RO3_DB_PATH=./data/ro3emu.db

# Live status endpoint for players online count
RO3_STATUS_URL=http://127.0.0.1:5380/ro3emu/status

# Administrator Credentials
ADMIN_USER=admin
ADMIN_PASSWORD=ChangeThisPassword123!

# Session expiration in hours
SESSION_TTL_HOURS=24
